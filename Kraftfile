spec: v0.6

name: elfloader

unikraft:
  source: https://github.com/shym/unikraft.git
  version: elfcompat
  kconfig:
    CONFIG_LIBUKRANDOM: y
    #CONFIG_LIBUKRANDOM_LCPU: y
    CONFIG_LIBPOSIX_PROCESS_MULTITHREADING: y
    CONFIG_LIBPOSIX_PROCESS_ARCH_PRCTL: y
    CONFIG_LIBUKBOOT_MAINTHREAD: y
    CONFIG_LIBPOSIX_FUTEX: y
    CONFIG_LIBUKALLOCPOOL: y
    CONFIG_LIBUKCPIO: y
    CONFIG_LIBRAMFS: y
    CONFIG_LIB9PFS: y
    CONFIG_LIBVIRTIO_9P: y
    CONFIG_LIBUK9P: y
    CONFIG_LIBVFSCORE_AUTOMOUNT: y
    CONFIG_LIBVFSCORE_AUTOMOUNT_UP: y
    CONFIG_LIBDEVFS: y
    CONFIG_LIBDEVFS_AUTOMOUNT: y
    CONFIG_LIBDEVFS_DEV_NULL: y
    CONFIG_LIBDEVFS_DEV_STDOUT: y
    CONFIG_LIBDEVFS_DEV_ZERO: y
    CONFIG_LIBLWIP: y
    CONFIG_LWIP_UNIKRAFT21X: y
    #
    CONFIG_LIBSYSCALL_SHIM_LEGACY_VERBOSE: n
    CONFIG_ENFORCE_W_XOR_X: n
    #
    # Debug
    CONFIG_LIBSYSCALL_SHIM_DEBUG_SYSCALLS: y
    CONFIG_LIBSYSCALL_SHIM_DEBUG_HANDLER: y
    CONFIG_LIBSYSCALL_SHIM_STRACE: y
    CONFIG_LIBSYSCALL_SHIM_STRACE_ANSI_COLOR: y
    CONFIG_LIBSYSCALL_SHIM_STRACE_PRINT_TYPE: y
    CONFIG_LIBUKDEBUG_PRINTD: y
    CONFIG_LIBUKDEBUG_ANSI_COLOR: y
    CONFIG_DEBUG_SYMBOLS_LVL2: y
    #
    # ARM 64 specific
    CONFIG_MCPU_ARM64_GENERIC: y
    CONFIG_FPSIMD: y

libraries:
  lwip: stable
  libelf: stable

targets:
- qemu/arm64
